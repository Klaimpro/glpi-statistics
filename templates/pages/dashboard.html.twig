<div class="card">
    <div class="card-header">
        <h2 class="card-title mb-0">{{ page_title }}</h2>
    </div>
    <div class="card-body">
        {% for error in errors %}
            <div class="alert alert-danger" role="alert">
                {{ error }}
            </div>
        {% endfor %}

        <div class="btn-group mb-4" role="group" aria-label="Navigation dsistats">
            <a href="/glpi/plugins/dsistats/front/graphs.php?from_month={{ filters.from_month }}&from_year={{ filters.from_year }}&to_month={{ filters.to_month }}&to_year={{ filters.to_year }}" class="btn {% if current_view == 'graphs' %}btn-primary{% else %}btn-outline-primary{% endif %}">
                {{ __('Graphiques', 'dsistats') }}
            </a>
            <a href="/glpi/plugins/dsistats/front/export.php?view=tables&from_month={{ filters.from_month }}&from_year={{ filters.from_year }}&to_month={{ filters.to_month }}&to_year={{ filters.to_year }}" class="btn btn-outline-danger">
                <i class="ti ti-file-type-pdf"></i>
                {{ __('Exporter en PDF', 'dsistats') }}
            </a>
        </div>

        <form method="get" class="mb-4">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-3">
                    <label for="from_month" class="form-label">{{ __('De', 'dsistats') }}</label>
                    <select id="from_month" name="from_month" class="form-select">
                        {% for value, label in month_choices %}
                            <option value="{{ value }}"{% if value == filters.from_month %} selected{% endif %}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <label for="from_year" class="form-label">{{ __('Année', 'dsistats') }}</label>
                    <input
                        id="from_year"
                        name="from_year"
                        type="number"
                        min="2000"
                        max="2100"
                        step="1"
                        class="form-control"
                        value="{{ filters.from_year }}"
                    >
                </div>
                <div class="col-12 col-md-3">
                    <label for="to_month" class="form-label">{{ __('À', 'dsistats') }}</label>
                    <select id="to_month" name="to_month" class="form-select">
                        {% for value, label in month_choices %}
                            <option value="{{ value }}"{% if value == filters.to_month %} selected{% endif %}>{{ label }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <label for="to_year" class="form-label">{{ __('Année', 'dsistats') }}</label>
                    <input
                        id="to_year"
                        name="to_year"
                        type="number"
                        min="2000"
                        max="2100"
                        step="1"
                        class="form-control"
                        value="{{ filters.to_year }}"
                    >
                </div>
                <div class="col-12 col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        {{ __('Actualiser', 'dsistats') }}
                    </button>
                </div>
            </div>
        </form>

        {% for group in groups %}
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="card-title mb-0">{{ group.group_label }}</h3>
                    {% if group.group_status == 'found' %}
                        <div class="small text-secondary">ID GLPI : {{ group.group_id }}</div>
                    {% else %}
                        <div class="small text-danger">{{ group.group_status_message }}</div>
                    {% endif %}
                </div>
                <div class="card-body">
                    <div class="table-responsive mb-4">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>{{ __('Mois', 'dsistats') }}</th>
                                    <th>{{ __('Résolution Incident', 'dsistats') }}</th>
                                    <th>{{ __('Résolution Demande', 'dsistats') }}</th>
                                    <th>{{ __('Prise en compte Incident', 'dsistats') }}</th>
                                    <th>{{ __('Prise en compte Demande', 'dsistats') }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in group.average_rows %}
                                    <tr>
                                        <td>{{ row.month_label }}</td>
                                        <td>
                                            <span class="{% if row.incident_solve.status == 'success' %}text-success{% elseif row.incident_solve.status == 'danger' %}text-danger{% else %}text-secondary{% endif %}" title="{% if row.incident_solve.status == 'success' %}Objectif respecté{% elseif row.incident_solve.status == 'danger' %}Objectif dépassé{% else %}Pas d'objectif ou donnée non calculable{% endif %}">●</span>
                                            {{ row.incident_solve.display }}
                                        </td>
                                        <td>
                                            <span class="{% if row.request_solve.status == 'success' %}text-success{% elseif row.request_solve.status == 'danger' %}text-danger{% else %}text-secondary{% endif %}" title="{% if row.request_solve.status == 'success' %}Objectif respecté{% elseif row.request_solve.status == 'danger' %}Objectif dépassé{% else %}Pas d'objectif ou donnée non calculable{% endif %}">●</span>
                                            {{ row.request_solve.display }}
                                        </td>
                                        <td>
                                            <span class="{% if row.incident_take.status == 'success' %}text-success{% elseif row.incident_take.status == 'danger' %}text-danger{% else %}text-secondary{% endif %}" title="{% if row.incident_take.status == 'success' %}Objectif respecté{% elseif row.incident_take.status == 'danger' %}Objectif dépassé{% else %}Pas d'objectif ou donnée non calculable{% endif %}">●</span>
                                            {{ row.incident_take.display }}
                                        </td>
                                        <td>
                                            <span class="{% if row.request_take.status == 'success' %}text-success{% elseif row.request_take.status == 'danger' %}text-danger{% else %}text-secondary{% endif %}" title="{% if row.request_take.status == 'success' %}Objectif respecté{% elseif row.request_take.status == 'danger' %}Objectif dépassé{% else %}Pas d'objectif ou donnée non calculable{% endif %}">●</span>
                                            {{ row.request_take.display }}
                                        </td>
                                    </tr>
                                {% endfor %}
                                <tr class="table-active fw-semibold">
                                    <td>{{ group.period_average_row.label }}</td>
                                    <td>
                                        <span class="{% if group.period_average_row.incident_solve.status == 'success' %}text-success{% elseif group.period_average_row.incident_solve.status == 'danger' %}text-danger{% else %}text-secondary{% endif %}" title="{% if group.period_average_row.incident_solve.status == 'success' %}Objectif respecté{% elseif group.period_average_row.incident_solve.status == 'danger' %}Objectif dépassé{% else %}Pas d'objectif ou donnée non calculable{% endif %}">●</span>
                                        {{ group.period_average_row.incident_solve.display }}
                                    </td>
                                    <td>
                                        <span class="{% if group.period_average_row.request_solve.status == 'success' %}text-success{% elseif group.period_average_row.request_solve.status == 'danger' %}text-danger{% else %}text-secondary{% endif %}" title="{% if group.period_average_row.request_solve.status == 'success' %}Objectif respecté{% elseif group.period_average_row.request_solve.status == 'danger' %}Objectif dépassé{% else %}Pas d'objectif ou donnée non calculable{% endif %}">●</span>
                                        {{ group.period_average_row.request_solve.display }}
                                    </td>
                                    <td>
                                        <span class="{% if group.period_average_row.incident_take.status == 'success' %}text-success{% elseif group.period_average_row.incident_take.status == 'danger' %}text-danger{% else %}text-secondary{% endif %}" title="{% if group.period_average_row.incident_take.status == 'success' %}Objectif respecté{% elseif group.period_average_row.incident_take.status == 'danger' %}Objectif dépassé{% else %}Pas d'objectif ou donnée non calculable{% endif %}">●</span>
                                        {{ group.period_average_row.incident_take.display }}
                                    </td>
                                    <td>
                                        <span class="{% if group.period_average_row.request_take.status == 'success' %}text-success{% elseif group.period_average_row.request_take.status == 'danger' %}text-danger{% else %}text-secondary{% endif %}" title="{% if group.period_average_row.request_take.status == 'success' %}Objectif respecté{% elseif group.period_average_row.request_take.status == 'danger' %}Objectif dépassé{% else %}Pas d'objectif ou donnée non calculable{% endif %}">●</span>
                                        {{ group.period_average_row.request_take.display }}
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm table-striped align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>{{ __('Mois', 'dsistats') }}</th>
                                    <th class="text-end">{{ __('Incidents', 'dsistats') }}</th>
                                    <th class="text-end">{{ __('Demandes', 'dsistats') }}</th>
                                    <th class="text-end">{{ __('Total', 'dsistats') }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in group.volume_rows %}
                                    <tr>
                                        <td>{{ row.month_label }}</td>
                                        <td class="text-end">{{ row.incident_count }}</td>
                                        <td class="text-end">{{ row.request_count }}</td>
                                        <td class="text-end">{{ row.total_count }}</td>
                                    </tr>
                                {% endfor %}
                                <tr class="table-active fw-semibold">
                                    <td>{{ group.volume_totals.label }}</td>
                                    <td class="text-end">{{ group.volume_totals.incident_count }}</td>
                                    <td class="text-end">{{ group.volume_totals.request_count }}</td>
                                    <td class="text-end">{{ group.volume_totals.total_count }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        {% endfor %}

        <p class="mb-1">
            <strong>{{ __('Période analysée', 'dsistats') }} :</strong>
            {{ period_label }}
        </p>
        <p class="mb-0 text-secondary">
            {{ visibility_note }}
        </p>
    </div>
</div>
